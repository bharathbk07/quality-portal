{
  "name": "vivegam-quality-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "node scripts/dev-frontend.mjs",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build frontend --webpack",
    "start": "next start frontend",
    "lint": "eslint . --max-warnings 0",
    "db:migrate": "node backend/database/migrate.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "test:services": "node --experimental-strip-types --test tests/*.test.mjs",
    "stack:up": "docker compose up --build -d",
    "stack:down": "docker compose down",
    "build:frontend": "NEXT_TELEMETRY_DISABLED=1 next build frontend --webpack",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json",
    "test:python": "backend/ai/.venv/bin/python -m pytest tests/test_ai.py tests/test_ai_guardrails.py",
    "lint:python": "backend/ai/.venv/bin/python -m ruff check backend/ai/src",
    "typecheck:python": "backend/ai/.venv/bin/python -m mypy --config-file backend/ai/pyproject.toml backend/ai/src",
    "check": "npm run lint && npm run typecheck && npm run test:services && npm run lint:python && npm run typecheck:python"
  },
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ]
}
