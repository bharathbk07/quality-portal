{
  "extends": "./frontend/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./frontend/src/*"
      ]
    }
  },
  "include": [
    "frontend/src/**/*.ts",
    "frontend/src/**/*.tsx",
    "backend/core/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "deployment/legacy-sites"
  ]
}
